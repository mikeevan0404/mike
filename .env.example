# ===== Telegram 群管机器人配置 =====

# 必填：@BotFather 创建的机器人 token（形如 123456789:AA...）
BOT_TOKEN=

# 必填：超级管理员 Telegram 用户 ID（多个用英文逗号分隔，如 12345678,87654321）
# 超级管理员在所有群里都视为管理员；普通群管理员由群内权限决定
ADMIN_IDS=

# 数据库文件路径（容器内路径，已挂载 volume 持久化）
DB_PATH=data/bot.db

# ===== 入群验证码 =====
CAPTCHA_ENABLED=true
CAPTCHA_TIMEOUT=300

# ===== 防刷屏 =====
FLOOD_WINDOW=10
FLOOD_THRESHOLD=5
FLOOD_MUTE_SECONDS=600

# ===== 链接白名单（逗号分隔，命中白名单域名不拦截） =====
LINK_WHITELIST=t.me,telegram.me,telegram.dog,youtube.com,youtu.be,github.com,gist.github.com

# ===== 日志级别：DEBUG / INFO / WARNING / ERROR =====
LOG_LEVEL=INFO

# ===== 网络代理（仅国内服务器需要，海外服务器留空） =====
# Telegram API 在部分地区无法直连，配置代理后可正常启动
# 支持 http/https/socks5，例如：http://127.0.0.1:7890
PROXY=

# ===== AI 自动回复（可选，不填则功能关闭） =====
# 开启 AI 回复（true/false）
AI_ENABLED=false
# OpenAI 兼容接口的 API Key（支持国内中转，如 DeepSeek、硅基流动等）
AI_API_KEY=
# 接口地址，默认官方 OpenAI；国内中转填对应地址，如 https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1
# 模型名，如 gpt-4o-mini / deepseek-chat
AI_MODEL=gpt-4o-mini
# 系统提示词（人设）
AI_SYSTEM_PROMPT=你是一个友好的 Telegram 群聊助手，用简体中文简短、自然地回答问题，避免长篇大论。
# 同一用户两次 AI 提问的最小间隔（秒），防止刷接口
AI_MIN_INTERVAL=30

# ===== 积分签到 =====
SIGN_DAILY_POINTS=1
# 连续签到满 N 天发放额外奖励
SIGN_STREAK_DAYS=7
# 连续签到奖励积分
SIGN_STREAK_BONUS=3
